# ─────────────────────────────────────────────────────────────
# 공개 값 (브라우저 번들에 포함됨. 비밀은 절대 여기 두지 않는다)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Supabase가 anon → publishable 키로 전환 중이다. 대시보드에서 현재 이름 확인.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MapLibre 벡터 타일 스타일. 제공자 대시보드에서 도메인 제한 + 월 상한 필수.
NEXT_PUBLIC_MAP_STYLE_URL=

# MSW 목 서버 (로컬 UI 개발용). 미설정이면 비활성.
NEXT_PUBLIC_ENABLE_MSW=true

# ─────────────────────────────────────────────────────────────
# 서버 전용 (Route Handler / proxy.ts 에서만 사용)
# ─────────────────────────────────────────────────────────────
# RLS 우회 키. 공유 링크 검증과 route_cache 기록에만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=

# estimate = 외부 호출 없이 직선거리 추정 (기본, 무료)
# osrm | mapbox | google = 실제 라우팅 API
ROUTING_PROVIDER=estimate
ROUTING_BASE_URL=
ROUTING_API_KEY=

# Nominatim 이용 정책상 User-Agent 는 필수다.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=travel-planner/0.1 (contact@example.com)

# 환율 (JPY → KRW 환산 표시)
FX_API_KEY=
