# ─────────────────────────────────────────────────────────────
# 공개 값 (브라우저 번들에 포함됨. 비밀은 절대 여기 두지 않는다)
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL/키. 비워두면 src/proxy.ts가 완전히 no-op으로
# 동작하고(docs/09-open-decisions.md), 앱은 MSW mock 데이터로 계속
# 작동한다(Phase 10 code-ready, 미연결). Cursor Dashboard > Secrets에
# 등록 → `supabase link` → `pnpm db:push` → `pnpm db:types` 순서로
# 실제 연결한다. 이 파일에 실제 값을 채우지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase가 anon → publishable 키로 전환 중이다. 대시보드에서 현재 이름 확인.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MSW 목 서버. 개발 환경 기본 ON, 프로덕션 빌드 기본 OFF.
# 프로덕션 빌드로 e2e를 검증할 때는 true로 강제한다(playwright.config.ts 참고).
NEXT_PUBLIC_ENABLE_MSW=true

# ─────────────────────────────────────────────────────────────
# 서버 전용 (Route Handler에서만 사용, NEXT_PUBLIC_ 접두사 없음)
# ─────────────────────────────────────────────────────────────

# Nominatim 이용 정책상 User-Agent 명시가 필수다 (app/api/geocode).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=travel-planner-dev/0.1 (contact@example.com)

# 환율(app/api/currency)은 Frankfurter를 쓴다 — 키가 필요 없다
# (docs/09 D11에서 실제 호출로 검증됨). 별도 환경변수 없음.

# RLS 우회 키. Phase 10 이후 실제로 필요해지면(예: 공유 링크 검증) 추가한다.
# 지금은 사용하는 코드가 없다.
# SUPABASE_SERVICE_ROLE_KEY=
